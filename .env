# ---- MongoDB ----
# Paste your connection string. For MongoDB Atlas it looks like:
#   mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/
# Leave the <db_password> placeholder in place and put the real password below
# (special characters are encoded automatically).
MONGODB_URL=
MONGODB_PASSWORD=
MONGODB_DB=prepmate

# ---- Auth ----
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Server ----
PORT=5000

# ---- Gemini (optional, used by JD analyzer and mock interview) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
